// MaxTiC-Next 两阶段流程 Nextflow 配置（P2-WF / T16）
//
// 默认在本地执行；可选地用 Docker 运行 maxtic-next 镜像
// （见仓库根 Dockerfile，构建后取消 docker.enabled 注释即可）。
//
// 运行示例（在**仓库根目录**，与 docs/manual/{zh,en}/07 章一致）：
//   nextflow -C workflows/nextflow.config run workflows/main.nf \
//       --species_tree examples/minitree.tree \
//       --constraints examples/Cyano_CUTConstraints.tsv
//
// 前置条件：`maxtic-next` 在 PATH 中（`pip install .` 或
// `pip install -e .`）；用 docker 模式时改由镜像提供。

process {
    // 所有进程复用同一执行器与资源上限
    executor    = 'local'
    cpus        = 1
    memory      = '2.GB'
    time        = '1.h'
}

// 可选：用 Docker 运行 MaxTiC-Next
// （取消注释并把 enabled 置 true 前，需先构建镜像：
//    docker build -t maxtic-next:0.1.0 .
//  镜像名/标签必须与 Dockerfile 头部、docs 01/07 章逐字一致；
//  Docker 仓库名不允许大写字母，旧版写的 'MaxTiC-Next:latest' 会报
//  invalid reference format —— 审阅 M18。）
docker {
    enabled = false
    // image   = 'maxtic-next:0.1.0'
    // runOptions = '-u $(id -u):$(id -g)'
}

// 执行概要 / 时间线 / 报告（便于排查）
timeline { enabled = true }
report   { enabled = true }
