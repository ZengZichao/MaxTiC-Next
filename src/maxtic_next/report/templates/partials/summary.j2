<div class="card">
  <h3>{{ t.h_meta }}</h3>
  <div class="meta">
    <b>{{ t.meta_version }}</b>{{ t.sep }}{{ version }}<br/>
    <b>{{ t.meta_seed }}</b>{{ t.sep }}{{ seed }}<br/>
    <b>{{ t.meta_params }}</b>{{ t.sep }}{{ params }}<br/>
    <b>{{ t.meta_constraints }}</b>{{ t.sep }}{{ constraint_file }}<br/>
    <b>{{ t.meta_nodes }}</b>{{ t.sep }}{{ internal_node_count }}<br/>
    <b>{{ t.meta_weight }}</b>{{ t.sep }}{{ total_weight }}<br/>
    <b>{{ t.meta_source }}</b>{{ t.sep }}{{ best_source }}<br/>
    <b>{{ t.meta_similarity }}</b>{{ t.sep }}{{ similarity_to_input }}<br/>
    <b>{{ t.meta_conflict }}</b>{{ t.sep }}{{ "%.4f"|format(conflict_ratio) }}
  </div>
  <h3>{{ t.h_values }}</h3>
  <ul>
    {% for k, v in values.items() %}
    <li>{{ k }}{{ t.sep }}{{ v }}</li>
    {% endfor %}
  </ul>
</div>
{{ robustness_html | safe }}
{{ tree_view_html | safe }}
